from typing import Literal

import numpy as np
import numpy.typing as npt

__version__: str

_F64 = npt.NDArray[np.float64]
_Bool = npt.NDArray[np.bool_]
_Side = Literal["call", "put"]
_Dist = Literal["normal", "t"]

def available() -> bool: ...

# Equity options (Black-Scholes-Merton, continuous dividend yield q)
def eq_bs_price(S: float, K: float, T: float, r: float, sigma: float, q: float = 0.0,
                option_type: _Side = "call") -> float: ...
def eq_bs_greeks(S: float, K: float, T: float, r: float, sigma: float, q: float = 0.0,
                 option_type: _Side = "call") -> dict[str, float]: ...
def eq_bs_price_batch(S: _F64, K: _F64, T: _F64, r: _F64, sigma: _F64, q: _F64,
                      is_call: _Bool) -> _F64: ...
def eq_bs_greeks_batch(S: _F64, K: _F64, T: _F64, r: _F64, sigma: _F64, q: _F64,
                       is_call: _Bool) -> dict[str, _F64]: ...
def eq_implied_vol(price: float, S: float, K: float, T: float, r: float, q: float = 0.0,
                   option_type: _Side = "call") -> float: ...
def eq_implied_vol_batch(price: _F64, S: _F64, K: _F64, T: _F64, r: _F64, q: _F64,
                         is_call: _Bool) -> _F64: ...
def eq_crr_price(S: float, K: float, T: float, r: float, sigma: float, q: float = 0.0,
                 option_type: _Side = "call", *, american: bool = True,
                 n_steps: int = 500) -> float: ...
def eq_mc_price(S: float, K: float, T: float, r: float, sigma: float, q: float = 0.0,
                option_type: _Side = "call", *, n_paths: int = 100000,
                antithetic: bool = True, control_variate: bool = True, seed: int = 42,
                threads: int = 1) -> dict[str, float]: ...

# FX options (Garman-Kohlhagen)
def fx_gk_price(S: float, K: float, T: float, r_d: float, r_f: float, sigma: float,
                option_type: _Side) -> float: ...
def fx_gk_greeks(S: float, K: float, T: float, r_d: float, r_f: float, sigma: float,
                 option_type: _Side) -> dict[str, float]: ...
def fx_gk_price_batch(S: _F64, K: _F64, T: _F64, r_d: _F64, r_f: _F64, sigma: _F64,
                      is_call: _Bool) -> _F64: ...
def fx_gk_greeks_batch(S: _F64, K: _F64, T: _F64, r_d: _F64, r_f: _F64, sigma: _F64,
                       is_call: _Bool) -> dict[str, _F64]: ...
def fx_implied_vol(price: float, S: float, K: float, T: float, r_d: float, r_f: float,
                   option_type: _Side) -> float: ...
def fx_implied_vol_batch(price: _F64, S: _F64, K: _F64, T: _F64, r_d: _F64, r_f: _F64,
                         is_call: _Bool) -> _F64: ...
def fx_binomial_price(S: float, K: float, T: float, r_d: float, r_f: float, sigma: float,
                      option_type: _Side, *, steps: int = 500,
                      american: bool = True) -> float: ...
def fx_mc_price(S: float, K: float, T: float, r_d: float, r_f: float, sigma: float,
                option_type: _Side, *, n_paths: int = 100000, seed: int = 0,
                antithetic: bool = True, control_variate: bool = True,
                threads: int = 1) -> dict[str, float | int | str]: ...

# Equity VaR (alpha = tail probability in (0, 0.5))
def eq_historical_var(pnl: _F64, *, alpha: float = 0.01) -> float: ...
def eq_expected_shortfall(pnl: _F64, *, alpha: float = 0.01) -> float: ...
def eq_parametric_var(exposures: _F64, cov: _F64, *, alpha: float = 0.01,
                      dist: _Dist = "normal", df: float = 6.0, mean: float = 0.0,
                      horizon_days: int = 1) -> float: ...
def eq_monte_carlo_var(exposures: _F64, cov: _F64, *, alpha: float = 0.01,
                       n_paths: int = 100000, dist: _Dist = "normal", df: float = 6.0,
                       seed: int = 0) -> float: ...
def eq_kupiec_pof(*, n_obs: int, n_exceptions: int, alpha: float = 0.01) -> dict[str, float]: ...
def eq_basel_traffic_light(*, n_obs: int, n_exceptions: int,
                           alpha: float = 0.01) -> dict[str, float | str]: ...

# FX VaR (alpha = tail probability in (0, 0.5))
def fx_empirical_var_es(pnl: _F64, *, alpha: float = 0.01) -> tuple[float, float]: ...
def fx_normal_var(sigma: float, *, alpha: float = 0.01, mean: float = 0.0) -> float: ...
def fx_normal_es(sigma: float, *, alpha: float = 0.01, mean: float = 0.0) -> float: ...
def fx_t_var(sigma: float, *, alpha: float = 0.01, df: float = 6.0,
             mean: float = 0.0) -> float: ...
def fx_t_es(sigma: float, *, alpha: float = 0.01, df: float = 6.0,
            mean: float = 0.0) -> float: ...
def fx_var_covar(exposures: _F64, cov: _F64, *, alpha: float = 0.01,
                 horizon_days: float = 1.0, dist: _Dist = "normal", df: float = 6.0,
                 mean: float = 0.0) -> tuple[float, float]: ...
def fx_kupiec_pof(*, n_obs: int, n_exceptions: int, alpha: float = 0.01) -> tuple[float, float]: ...
def fx_basel_traffic_light(*, n_obs: int, n_exceptions: int,
                           alpha: float = 0.01) -> dict[str, float | int | str]: ...
